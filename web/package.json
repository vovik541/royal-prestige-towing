{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "build": "ng build",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "preview:cloudflare": "wrangler dev",
